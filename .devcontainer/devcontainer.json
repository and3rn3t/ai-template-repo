// Dev Container for the web profile (Node 24 + pnpm + wrangler).
// Docs: https://containers.dev/implementors/json_reference/
{
  "name": "and3rn3t web",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // corepack provisions the pnpm version pinned in package.json "packageManager".
  // Skips install where the root has no package.json (e.g. ai-template-repo itself).
  "postCreateCommand": "sudo corepack enable && if [ -f package.json ]; then COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm install; fi",
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": { "label": "Vite" },
    "8787": { "label": "wrangler dev" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "github.copilot-chat",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteUser": "node"
}
