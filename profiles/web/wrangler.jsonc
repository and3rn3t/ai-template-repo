// Cloudflare Workers + static assets (SPA). Docs:
// https://developers.cloudflare.com/workers/static-assets/
// Secrets: `wrangler secret put NAME` (local: .dev.vars) — never in this file.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "replace-project-name",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": true },
  // Add an API: set "main": "worker/index.ts" and
  // "assets": { ..., "binding": "ASSETS", "run_worker_first": ["/api/*"] }
  // "kv_namespaces": [{ "binding": "MY_KV", "id": "..." }]
}
